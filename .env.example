# SMTP credentials stay on the server and are never exposed to Vite.
PORT=3001

# Owner/Admin contact email
OWNER_EMAIL=
ADMIN_EMAIL=

# SMTP Configuration (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Admin credentials - set these only in the local .env file
ADMIN_PASSWORD=

# Session secret - generate a random value for each deployment
SESSION_SECRET=
