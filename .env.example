# SMTP credentials stay on the server and are never exposed to Vite.
PORT=3001

# Owner/Admin contact email
OWNER_EMAIL=dev.get.in.touch@gmail.com
ADMIN_EMAIL=dev.get.in.touch@gmail.com

# SMTP Configuration (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sending-gmail@gmail.com
SMTP_PASS=your-gmail-app-password

# Admin credentials - set these only in the local .env file
ADMIN_PASSWORD=change-this-before-deployment

# Session secret - generate a random value for each deployment
SESSION_SECRET=generate-a-long-random-value