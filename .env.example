# SMTP credentials stay on the server and are never exposed to Vite.
PORT=3001

# Owner/Admin contact email
OWNER_EMAIL=your-owner@gmail.com
ADMIN_EMAIL=your-admin@gmail.com

# SMTP Configuration (Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-smtp-user@gmail.com
SMTP_PASS=your-gmail-app-password

# Admin credentials - keep this file private
ADMIN_PASSWORD=replace-with-a-strong-password

# Session secret - keep this file private
SESSION_SECRET=replace-with-a-long-random-secret